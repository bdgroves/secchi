# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual envs (kept even though pixi is primary — belt and suspenders)
.venv/
venv/
env/
ENV/

# Pixi
# Note: pixi.lock is intentionally NOT ignored — it pins per-platform
# resolutions and is how pixi delivers "same env everywhere". Commit it.
.pixi/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Linters / type checkers
.ruff_cache/
.mypy_cache/
.pyright/

# Node (for any dashboard tooling later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment / secrets
.env
.env.local
.env.*.local
*.pem

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Data — keep the folder structure but ignore bulky intermediates.
# Committed raw pulls and processed outputs are handled explicitly
# by the ingest workflow; anything below is scratch.
data/scratch/
*.tmp

# Generated at deploy time by .github/workflows/pages.yml
web/assets/latest.json
data/processed/*.parquet
