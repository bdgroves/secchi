<Project Sdk="Microsoft.NET.Sdk">

  <!-- secchi-cloud: load with SqlBulkCopy, and fingerprint SQL Server in C#.
       Build: dotnet build -c Release cloud/dotnet/Secchi.Cloud.Cli -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Off: Microsoft.Data.SqlClient refuses to connect in invariant mode
         ("Globalization Invariant Mode is not supported"); it maps SQL
         Server collations to code pages through the culture data. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>secchi-cloud</AssemblyName>
    <RootNamespace>Secchi.Cloud.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Secchi.Cloud.Core\Secchi.Cloud.Core.csproj" />
  </ItemGroup>

</Project>
